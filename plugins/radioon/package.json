{
  "name": "radioon",
  "version": "1.0.0",
  "description": "RadioOn plugin for Teckdato",
  "license": "ISC",
  "author": "Teckdato",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist",
    "*.js",
    "*.d.ts",
    "*.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@teckdato/kernel": "workspace:*",
    "@teckdato/sdk": "workspace:*",
    "@teckdato/logger": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
